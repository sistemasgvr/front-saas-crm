# Plantilla — copia a .env y rellena.
# En producción (Hostinger/Vercel) configura las mismas claves en el panel.

# Dev:  http://localhost:4000/api
# Prod: https://back-saas-crm.vercel.app/api
API_URL=http://localhost:4000/api

# Dev:  http://localhost:4000
# Prod: https://back-saas-crm.vercel.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Debe coincidir con VAPID_PUBLIC_KEY del backend (misma clave pública).
# La privada NUNCA va aquí.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Solo "true" si necesitas Web Push en localhost (por defecto no se registra).
# NEXT_PUBLIC_ENABLE_PUSH_ON_LOCALHOST=true

# Opcional — GIFs en chats (Klipy)
NEXT_PUBLIC_KLIPY_API_KEY=
