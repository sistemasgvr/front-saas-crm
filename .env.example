# Plantilla — copia a .env y rellena.
# En producción (Hostinger/Vercel) configura las mismas claves en el panel.

# Dev:  http://localhost:4000/api
# Prod: https://back-saas-crm.vercel.app/api
API_URL=http://localhost:4000/api

# Dev:  http://localhost:4000
# Prod: https://back-saas-crm.vercel.app
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# Debe coincidir con VAPID_PUBLIC_KEY del backend
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Opcional — GIFs en chats (Klipy)
NEXT_PUBLIC_KLIPY_API_KEY=
